# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inmath
DB_USER=inmath
DB_PASS=
# Opcional: socket unix en lugar de host/puerto
# DB_SOCKET=/tmp/mysql.sock

# API key compartida con n8n (header X-API-Key). Generar con:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
API_KEY=

# desarrollo | produccion (en desarrollo los errores 500 incluyen detalle)
APP_ENV=produccion
APP_TZ=America/Mexico_City

# Agente de IA (chat flotante del sitio y del panel) — Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Solo si el panel CRM se sirve como subcarpeta del sitio (p. ej. "/panel").
# Vacío si el panel tiene su propio (sub)dominio o docroot.
PANEL_BASE_PATH=

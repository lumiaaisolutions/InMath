# Base de datos
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inmath
DB_USER=inmath
DB_PASS=
# Opcional: socket unix en lugar de host/puerto
# DB_SOCKET=/tmp/mysql.sock

# API key compartida con n8n (header X-API-Key). Generar con:
# php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
API_KEY=

# desarrollo | produccion (en desarrollo los errores 500 incluyen detalle)
APP_ENV=produccion
APP_TZ=America/Mexico_City

# Google Gemini — usado por dos consumidores independientes:
# 1) El agente de IA "Mathy" (chat flotante del sitio y del panel).
# 2) El motor conversacional del bot de WhatsApp (App\Bot\GeminiClient),
#    activo solo cuando BOT_SIMULADO=0 y ya haya credenciales de WhatsApp
#    Business Cloud API conectadas en n8n.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# 0 = el bot de WhatsApp llama a Gemini de verdad. 1 = respuestas deterministas
# sin llamar a la API (pruebas locales / mientras no haya GEMINI_API_KEY).
BOT_SIMULADO=0

# Solo si el panel CRM se sirve como subcarpeta del sitio (p. ej. "/panel").
# Vacío si el panel tiene su propio (sub)dominio o docroot.
PANEL_BASE_PATH=

# URL pública del sitio (sin slash final), para construir back_urls/notification_url
# de MercadoPago. Ej.: https://cursos.inmath.mx
APP_URL=

# MercadoPago (procesador_pago_activo = mercadopago en la tabla configuraciones).
# Access token: panel de desarrolladores de MercadoPago > Tus integraciones >
# Credenciales de producción. Webhook secret: la misma sección > Webhooks >
# Configurar notificaciones (se revela al hacer clic, tiene botón de Reset).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=

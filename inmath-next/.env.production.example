# Copia a .env en el VPS y llena los valores. NUNCA se commitea el .env real.

# MySQL de producción (la MISMA BD que usa el PHP durante el strangler).
# IMPORTANTE: el motor Rust de Prisma NO negocia bien caching_sha2_password de
# MySQL 8 (falla intermitentemente con "Unknown authentication plugin
# 'sha256_password'" cuando el caché de contraseña está frío). Solución robusta
# aplicada en prod: una cuenta dedicada con mysql_native_password que el TCP
# alcance directamente:
#   CREATE USER 'inmath'@'127.0.0.1' IDENTIFIED WITH mysql_native_password BY '...';
#   GRANT ALL ON inmath.* TO 'inmath'@'127.0.0.1'; FLUSH PRIVILEGES;
# y conectar por TCP (no socket) a 127.0.0.1:
DATABASE_URL="mysql://USUARIO:PASSWORD@127.0.0.1:3306/BASE"

# WhatsApp del negocio (formato internacional sin +; MX = 521 + 10 dígitos)
WHATSAPP_NUMERO=5217224709235

# URL pública del sitio (para links de pago, back_urls y "Volver al sitio")
APP_URL=https://inmath.lumiaaisolutions.com
# URL del panel (enlace "Entrar" del sitio)
PANEL_URL=https://inmath.lumiaaisolutions.com/panel

# Firma de sesiones del panel y tokens de comprobante — generar con:
#   openssl rand -hex 32
APP_SECRET=

# API key máquina-a-máquina para n8n (la MISMA que usa hoy el PHP)
API_KEY=

# Gemini (mismo key que local, por decisión del cliente)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# 1 = respuestas deterministas sin llamar a Gemini (solo pruebas)
BOT_SIMULADO=0

# Webhook simulado de pagos (pruebas E2E); MercadoPago cuando haya credenciales
PAGO_WEBHOOK_SECRET=
# MERCADOPAGO_ACCESS_TOKEN=
# MERCADOPAGO_WEBHOOK_SECRET=

# Directorios compartidos con el PHP durante el strangler (rutas del VPS)
# COMPROBANTES_DIR=/srv/inmath/storage/comprobantes
# STORAGE_DIR=/srv/inmath/storage
# PANEL_IMG_DIR=/srv/inmath/panel-img

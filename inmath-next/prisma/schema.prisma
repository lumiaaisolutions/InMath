generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model alumnos {
  id                 Int                   @id @default(autoincrement()) @db.UnsignedInt
  prospecto_id       Int                   @unique(map: "prospecto_id") @db.UnsignedInt
  curso_id           Int                   @db.UnsignedInt
  nombre             String                @db.VarChar(120)
  telefono           String                @db.VarChar(20)
  email              String?               @db.VarChar(190)
  usuario            String?               @db.VarChar(60)
  password_hash      String?               @db.VarChar(255)
  canal_reporte      alumnos_canal_reporte @default(whatsapp)
  estado             alumnos_estado        @default(activo)
  inscrito_en        DateTime              @db.DateTime(0)
  creado_en          DateTime              @default(now()) @db.Timestamp(0)
  actualizado_en     DateTime              @default(now()) @db.Timestamp(0)
  cursos             cursos                @relation(fields: [curso_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_alumnos_curso")
  prospectos         prospectos            @relation(fields: [prospecto_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_alumnos_prospecto")
  avance_alumnos     avance_alumnos[]
  pagos              pagos[]
  reportes_generados reportes_generados[]
  intentos_practica  intentos_practica[]

  @@index([curso_id], map: "fk_alumnos_curso")
  @@index([estado], map: "idx_alumnos_estado")
}

model avance_alumnos {
  id         Int      @id @default(autoincrement()) @db.UnsignedInt
  alumno_id  Int      @db.UnsignedInt
  fecha      DateTime @db.Date
  porcentaje Int      @db.UnsignedTinyInt
  detalle    Json?
  creado_en  DateTime @default(now()) @db.Timestamp(0)
  alumnos    alumnos  @relation(fields: [alumno_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_avance_alumno")

  @@unique([alumno_id, fecha], map: "uq_avance_alumno_fecha")
}

model bitacora_pipeline {
  id             BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  prospecto_id   Int                      @db.UnsignedInt
  etapa_anterior String?                  @db.VarChar(30)
  etapa_nueva    String                   @db.VarChar(30)
  origen         bitacora_pipeline_origen @default(sistema)
  usuario_id     Int?                     @db.UnsignedInt
  nota           String?                  @db.VarChar(255)
  creado_en      DateTime                 @default(now()) @db.Timestamp(0)
  prospectos     prospectos               @relation(fields: [prospecto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_bitacora_prospecto")

  @@index([prospecto_id, creado_en], map: "idx_bitacora_prospecto")
}

model citas {
  id                      Int          @id @default(autoincrement()) @db.UnsignedInt
  prospecto_id            Int          @db.UnsignedInt
  asesor_id               Int          @db.UnsignedInt
  inicio                  DateTime     @db.DateTime(0)
  fin                     DateTime     @db.DateTime(0)
  google_event_id         String?      @db.VarChar(190)
  meet_link               String?      @db.VarChar(255)
  estado                  citas_estado @default(agendada)
  recordatorio_enviado_en DateTime?    @db.DateTime(0)
  creado_en               DateTime     @default(now()) @db.Timestamp(0)
  actualizado_en          DateTime     @default(now()) @db.Timestamp(0)
  usuarios                usuarios     @relation(fields: [asesor_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_citas_asesor")
  prospectos              prospectos   @relation(fields: [prospecto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_citas_prospecto")

  @@unique([asesor_id, inicio], map: "uq_citas_asesor_inicio")
  @@index([asesor_id, inicio, fin], map: "idx_citas_asesor_rango")
  @@index([prospecto_id], map: "idx_citas_prospecto")
}

model configuraciones {
  clave           String               @id @db.VarChar(80)
  valor           String               @db.Text
  tipo            configuraciones_tipo @default(texto)
  descripcion     String?              @db.VarChar(255)
  actualizado_por Int?                 @db.UnsignedInt
  actualizado_en  DateTime             @default(now()) @db.Timestamp(0)
  usuarios        usuarios?            @relation(fields: [actualizado_por], references: [id], onUpdate: NoAction, map: "fk_config_usuario")

  @@index([actualizado_por], map: "fk_config_usuario")
}

model conversaciones {
  id                  Int                   @id @default(autoincrement()) @db.UnsignedInt
  prospecto_id        Int                   @db.UnsignedInt
  canal               conversaciones_canal  @default(whatsapp)
  estado              conversaciones_estado @default(bot)
  asesor_id           Int?                  @db.UnsignedInt
  ultima_actividad_en DateTime?             @db.DateTime(0)
  creado_en           DateTime              @default(now()) @db.Timestamp(0)
  actualizado_en      DateTime              @default(now()) @db.Timestamp(0)
  usuarios            usuarios?             @relation(fields: [asesor_id], references: [id], onUpdate: NoAction, map: "fk_conv_asesor")
  prospectos          prospectos            @relation(fields: [prospecto_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_conv_prospecto")
  mensajes            mensajes[]

  @@unique([prospecto_id, canal], map: "uq_conv_prospecto_canal")
  @@index([asesor_id], map: "fk_conv_asesor")
}

model cursos {
  id                       Int              @id @default(autoincrement()) @db.UnsignedInt
  nombre                   String           @db.VarChar(190)
  descripcion              String?          @db.Text
  imagen                   String?          @db.VarChar(255)
  precio_centavos          Int              @db.UnsignedInt
  precio_original_centavos Int?             @db.UnsignedInt
  moneda                   String           @default("MXN") @db.Char(3)
  duracion_semanas         Int?             @db.UnsignedSmallInt
  modalidad                cursos_modalidad @default(asesorias)
  promocion_activa         Boolean          @default(false)
  promocion_texto          String?          @db.VarChar(160)
  promocion_expira_en      DateTime?        @db.DateTime(0)
  destacado                Boolean          @default(false)
  orden                    Int              @default(0) @db.UnsignedSmallInt
  activo                   Boolean          @default(true)
  creado_en                DateTime         @default(now()) @db.Timestamp(0)
  actualizado_en           DateTime         @default(now()) @db.Timestamp(0)
  alumnos                  alumnos[]
  pagos                    pagos[]
  prospectos               prospectos[]
  reactivos                reactivos[]
  intentos_practica        intentos_practica[]
  cupones                  cupones[]
  fases                    fases[]
  examen_cursos            examen_cursos[]
}

model cupones {
  id            Int          @id @default(autoincrement()) @db.UnsignedInt
  codigo        String       @unique(map: "codigo") @db.VarChar(40)
  tipo          cupones_tipo
  valor         Int          @db.UnsignedInt
  curso_id      Int?         @db.UnsignedInt
  activo        Boolean      @default(true)
  usos_maximos  Int?         @db.UnsignedInt
  expira_en     DateTime?    @db.DateTime(0)
  creado_por    Int?         @db.UnsignedInt
  creado_en     DateTime     @default(now()) @db.Timestamp(0)
  cursos        cursos?      @relation(fields: [curso_id], references: [id], onUpdate: NoAction, map: "fk_cupones_curso")
  usuarios      usuarios?    @relation(fields: [creado_por], references: [id], onUpdate: NoAction, map: "fk_cupones_usuario")
  pagos         pagos[]

  @@index([curso_id], map: "fk_cupones_curso")
}

enum cursos_modalidad {
  asesorias
  video
  ambos
}

enum cupones_tipo {
  porcentaje
  monto_fijo
}

/// `curso_id` solo aplica a reactivos SUELTOS (sin examen, práctica libre por
/// tema): ahí sigue siendo 1 curso fijo. Un reactivo agrupado en un examen
/// (examen_id no nulo) tiene curso_id NULL — su visibilidad la da
/// `examen_cursos` del examen al que pertenece, no esta columna.
model reactivos {
  id                 Int       @id @default(autoincrement()) @db.UnsignedInt
  curso_id           Int?      @db.UnsignedInt
  examen_id          Int?      @db.UnsignedInt
  orden              Int?      @db.UnsignedSmallInt
  tema               String?   @db.VarChar(120)
  enunciado          String    @db.Text
  opciones           Json
  opciones_tipo      Json?
  respuesta_correcta Int       @db.UnsignedTinyInt
  explicacion        String?   @db.Text
  adjunto_url        String?   @db.VarChar(255)
  adjunto_tipo       String?   @db.VarChar(20)
  activo             Boolean   @default(true)
  creado_por         Int?      @db.UnsignedInt
  creado_en          DateTime  @default(now()) @db.Timestamp(0)
  actualizado_en     DateTime  @default(now()) @db.Timestamp(0)
  cursos             cursos?   @relation(fields: [curso_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_reactivos_curso")
  usuarios           usuarios? @relation(fields: [creado_por], references: [id], onUpdate: NoAction, map: "fk_reactivos_usuario")
  examenes           examenes? @relation(fields: [examen_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_reactivos_examen")

  @@index([curso_id, activo], map: "idx_reactivos_curso")
  @@index([curso_id, tema], map: "idx_reactivos_tema")
  @@index([examen_id, orden], map: "idx_reactivos_examen")
}

/// Agrupa varios reactivos como "examen" (además de seguir sirviendo para práctica libre por curso/tema).
/// El examen ya NO pertenece a un solo curso: es genérico, y `examen_cursos`
/// dice en qué modalidad(es) el admin decidió mostrarlo (evita duplicar
/// preguntas por curso — antes cada modalidad necesitaba su propia copia).
model examenes {
  id                Int                  @id @default(autoincrement()) @db.UnsignedInt
  titulo            String               @db.VarChar(160)
  tema              String?              @db.VarChar(120)
  etiqueta_id       Int?                 @db.UnsignedInt
  activo            Boolean              @default(true)
  porcentaje_minimo Int                  @default(70) @db.UnsignedTinyInt
  orden_aleatorio   Boolean              @default(true)
  creado_por        Int?                 @db.UnsignedInt
  creado_en         DateTime             @default(now()) @db.Timestamp(0)
  actualizado_en    DateTime             @default(now()) @db.Timestamp(0)
  usuarios          usuarios?            @relation(fields: [creado_por], references: [id], onUpdate: NoAction, map: "fk_examenes_usuario")
  etiquetas         etiquetas?           @relation(fields: [etiqueta_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_examenes_etiqueta")
  reactivos         reactivos[]
  adjuntos          examen_adjuntos[]
  fase_examenes     fase_examenes[]
  intentos_practica intentos_practica[]
  examen_cursos     examen_cursos[]

  @@index([activo], map: "idx_examenes_activo")
}

/// Relación N:M — en qué modalidad(es)/curso(s) aparece un examen genérico.
model examen_cursos {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  examen_id Int      @db.UnsignedInt
  curso_id  Int      @db.UnsignedInt
  examenes  examenes @relation(fields: [examen_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_examen_cursos_examen")
  cursos    cursos   @relation(fields: [curso_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_examen_cursos_curso")

  @@unique([examen_id, curso_id], map: "uq_examen_cursos")
  @@index([curso_id], map: "idx_examen_cursos_curso")
}

/// Fase de la ruta de aprendizaje (estilo Udemy): videos/materiales + uno o
/// varios exámenes que hay que aprobar para desbloquear la siguiente fase.
model fases {
  id                Int                 @id @default(autoincrement()) @db.UnsignedInt
  curso_id          Int                 @db.UnsignedInt
  titulo            String              @db.VarChar(160)
  descripcion       String?             @db.Text
  orden             Int                 @default(0) @db.UnsignedSmallInt
  porcentaje_minimo Int                 @default(70) @db.UnsignedTinyInt
  activo            Boolean             @default(true)
  creado_por        Int?                @db.UnsignedInt
  creado_en         DateTime            @default(now()) @db.Timestamp(0)
  actualizado_en    DateTime            @default(now()) @db.Timestamp(0)
  cursos            cursos              @relation(fields: [curso_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_fases_curso")
  usuarios          usuarios?           @relation(fields: [creado_por], references: [id], onUpdate: NoAction, map: "fk_fases_usuario")
  recursos          fase_recursos[]
  fase_examenes     fase_examenes[]
  intentos_practica intentos_practica[]

  @@index([curso_id, activo, orden], map: "idx_fases_curso")
}

/// Video (link o archivo subido) o documento de apoyo dentro de una fase.
model fase_recursos {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  fase_id   Int      @db.UnsignedInt
  tipo      String   @db.VarChar(20)
  titulo    String   @db.VarChar(160)
  url       String   @db.VarChar(500)
  orden     Int      @default(0) @db.UnsignedSmallInt
  creado_en DateTime @default(now()) @db.Timestamp(0)
  fases     fases    @relation(fields: [fase_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fase_recursos_fase")

  @@index([fase_id, orden], map: "idx_fase_recursos_fase")
}

/// Relación N:M — qué exámenes (del banco de reactivos) hay que aprobar para pasar una fase.
model fase_examenes {
  id        Int      @id @default(autoincrement()) @db.UnsignedInt
  fase_id   Int      @db.UnsignedInt
  examen_id Int      @db.UnsignedInt
  orden     Int      @default(0) @db.UnsignedSmallInt
  fases     fases    @relation(fields: [fase_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fase_examenes_fase")
  examenes  examenes @relation(fields: [examen_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_fase_examenes_examen")

  @@unique([fase_id, examen_id], map: "uq_fase_examenes")
}

/// Imagen/video/documento de apoyo para un rango de preguntas (desde_orden..hasta_orden) dentro de un examen.
model examen_adjuntos {
  id          Int      @id @default(autoincrement()) @db.UnsignedInt
  examen_id   Int      @db.UnsignedInt
  desde_orden Int      @db.UnsignedSmallInt
  hasta_orden Int      @db.UnsignedSmallInt
  tipo        String   @db.VarChar(20)
  nombre      String   @db.VarChar(160)
  url         String   @db.VarChar(255)
  creado_en   DateTime @default(now()) @db.Timestamp(0)
  examenes    examenes @relation(fields: [examen_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_adjuntos_examen")

  @@index([examen_id], map: "idx_adjuntos_examen")
}

model intentos_practica {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  alumno_id       Int       @db.UnsignedInt
  curso_id        Int       @db.UnsignedInt
  tema            String?   @db.VarChar(120)
  examen_id       Int?      @db.UnsignedInt
  fase_id         Int?      @db.UnsignedInt
  total_preguntas Int       @db.UnsignedSmallInt
  correctas       Int       @db.UnsignedSmallInt
  porcentaje      Int       @db.UnsignedTinyInt
  respuestas      Json
  creado_en       DateTime  @default(now()) @db.Timestamp(0)
  alumnos         alumnos   @relation(fields: [alumno_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_intentos_alumno")
  cursos          cursos    @relation(fields: [curso_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_intentos_curso")
  examenes        examenes? @relation(fields: [examen_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_intentos_examen")
  fases           fases?    @relation(fields: [fase_id], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "fk_intentos_fase")

  @@index([alumno_id, creado_en], map: "idx_intentos_alumno")
  @@index([fase_id, examen_id], map: "idx_intentos_fase_examen")
}

model mensajes {
  id              BigInt                   @id @default(autoincrement()) @db.UnsignedBigInt
  conversacion_id Int                      @db.UnsignedInt
  direccion       mensajes_direccion
  emisor          mensajes_emisor
  tipo            mensajes_tipo            @default(texto)
  contenido       String                   @db.Text
  wa_message_id   String?                  @unique(map: "wa_message_id") @db.VarChar(128)
  estado_entrega  mensajes_estado_entrega?
  metadatos       Json?
  creado_en       DateTime                 @default(now()) @db.Timestamp(0)
  conversaciones  conversaciones           @relation(fields: [conversacion_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_mensajes_conversacion")

  @@index([conversacion_id, creado_en], map: "idx_mensajes_conv_fecha")
}

model migraciones {
  archivo     String   @id @db.VarChar(190)
  aplicado_en DateTime @default(now()) @db.Timestamp(0)
}

model pagos {
  id                      Int          @id @default(autoincrement()) @db.UnsignedInt
  prospecto_id            Int          @db.UnsignedInt
  alumno_id               Int?         @db.UnsignedInt
  curso_id                Int          @db.UnsignedInt
  procesador              String?      @db.VarChar(30)
  monto_centavos          Int          @db.UnsignedInt
  descuento_centavos      Int?         @db.UnsignedInt
  cupon_id                Int?         @db.UnsignedInt
  moneda                  String       @default("MXN") @db.Char(3)
  link_pago               String?      @db.VarChar(500)
  comprobante             String?      @db.VarChar(255)
  comprobante_subido_en   DateTime?    @db.DateTime(0)
  referencia_externa      String?      @unique(map: "referencia_externa") @db.VarChar(190)
  estado                  pagos_estado @default(pendiente)
  link_generado_en        DateTime?    @db.DateTime(0)
  expira_en               DateTime?    @db.DateTime(0)
  pagado_en               DateTime?    @db.DateTime(0)
  recordatorio_enviado_en DateTime?    @db.DateTime(0)
  metadatos               Json?
  creado_en               DateTime     @default(now()) @db.Timestamp(0)
  actualizado_en          DateTime     @default(now()) @db.Timestamp(0)
  alumnos                 alumnos?     @relation(fields: [alumno_id], references: [id], onUpdate: NoAction, map: "fk_pagos_alumno")
  cursos                  cursos       @relation(fields: [curso_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pagos_curso")
  prospectos              prospectos   @relation(fields: [prospecto_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_pagos_prospecto")
  cupones                 cupones?     @relation(fields: [cupon_id], references: [id], onUpdate: NoAction, map: "fk_pagos_cupon")

  @@index([alumno_id], map: "fk_pagos_alumno")
  @@index([curso_id], map: "fk_pagos_curso")
  @@index([cupon_id], map: "fk_pagos_cupon")
  @@index([prospecto_id], map: "fk_pagos_prospecto")
  @@index([estado, link_generado_en, recordatorio_enviado_en], map: "idx_pagos_recuperacion")
}

model prompts {
  id              Int       @id @default(autoincrement()) @db.UnsignedInt
  clave           String    @db.VarChar(80)
  contenido       String    @db.MediumText
  version         Int       @default(1) @db.UnsignedInt
  activo          Boolean   @default(true)
  notas           String?   @db.VarChar(255)
  actualizado_por Int?      @db.UnsignedInt
  creado_en       DateTime  @default(now()) @db.Timestamp(0)
  usuarios        usuarios? @relation(fields: [actualizado_por], references: [id], onUpdate: NoAction, map: "fk_prompts_usuario")

  @@unique([clave, version], map: "uq_prompts_clave_version")
  @@index([actualizado_por], map: "fk_prompts_usuario")
  @@index([clave, activo], map: "idx_prompts_activos")
}

model prospectos {
  id                   Int                 @id @default(autoincrement()) @db.UnsignedInt
  telefono_whatsapp    String              @unique(map: "telefono_whatsapp") @db.VarChar(20)
  nombre               String?             @db.VarChar(120)
  correo               String?             @db.VarChar(190)
  fuente               prospectos_fuente   @default(facebook)
  etapa                prospectos_etapa    @default(prospecto)
  puntaje_calificacion Int?                @db.UnsignedTinyInt
  datos_calificacion   Json?
  curso_interes_id     Int?                @db.UnsignedInt
  asesor_id            Int?                @db.UnsignedInt
  asignado_en          DateTime?           @db.DateTime(0)
  motivo_descarte      String?             @db.VarChar(255)
  creado_en            DateTime            @default(now()) @db.Timestamp(0)
  actualizado_en       DateTime            @default(now()) @db.Timestamp(0)
  alumnos              alumnos?
  bitacora_pipeline    bitacora_pipeline[]
  citas                citas[]
  conversaciones       conversaciones[]
  pagos                pagos[]
  usuarios             usuarios?           @relation(fields: [asesor_id], references: [id], onUpdate: NoAction, map: "fk_prospectos_asesor")
  cursos               cursos?             @relation(fields: [curso_interes_id], references: [id], onUpdate: NoAction, map: "fk_prospectos_curso")

  @@index([curso_interes_id], map: "fk_prospectos_curso")
  @@index([asesor_id, etapa], map: "idx_prospectos_asesor")
  @@index([etapa], map: "idx_prospectos_etapa")
}

model reportes_generados {
  id             Int                      @id @default(autoincrement()) @db.UnsignedInt
  alumno_id      Int                      @db.UnsignedInt
  periodo_inicio DateTime                 @db.Date
  periodo_fin    DateTime                 @db.Date
  archivo        String                   @db.VarChar(255)
  canal          reportes_generados_canal
  enviado_en     DateTime?                @db.DateTime(0)
  creado_en      DateTime                 @default(now()) @db.Timestamp(0)
  alumnos        alumnos                  @relation(fields: [alumno_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reportes_alumno")

  @@unique([alumno_id, periodo_inicio], map: "uq_reporte_alumno_periodo")
  @@index([enviado_en], map: "idx_reportes_envio")
}

model usuarios {
  id                 Int               @id @default(autoincrement()) @db.UnsignedInt
  nombre             String            @db.VarChar(120)
  email              String            @unique(map: "email") @db.VarChar(190)
  password_hash      String            @db.VarChar(255)
  rol                usuarios_rol      @default(asesor)
  es_asesor          Boolean           @default(false)
  modulos            Json?
  telefono           String?           @db.VarChar(20)
  google_calendar_id String?           @db.VarChar(190)
  activo             Boolean           @default(true)
  creado_en          DateTime          @default(now()) @db.Timestamp(0)
  actualizado_en     DateTime          @default(now()) @db.Timestamp(0)
  citas              citas[]
  configuraciones    configuraciones[]
  conversaciones     conversaciones[]
  prompts            prompts[]
  prospectos         prospectos[]
  reactivos          reactivos[]
  cupones            cupones[]
  examenes           examenes[]
  fases              fases[]
}

enum configuraciones_tipo {
  texto
  numero
  json
  booleano
}

